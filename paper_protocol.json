{
  "schema": "paper_protocol",
  "paper": "ICASSP 2027",
  "reporting": {
    "stochastic_seed": 9002,
    "deterministic_methods": [
      "EAC",
      "ECPCS-HC"
    ],
    "missing_result_display": "--"
  },
  "datasets": [
    {"dataset_id": "D1", "dataset": "Yale"},
    {"dataset_id": "D2", "dataset": "ProteinFold"},
    {"dataset_id": "D3", "dataset": "COIL20"},
    {"dataset_id": "D4", "dataset": "Communities"},
    {"dataset_id": "D5", "dataset": "Obesity"},
    {"dataset_id": "D6", "dataset": "USPS"},
    {"dataset_id": "D7", "dataset": "PAMAP2"},
    {"dataset_id": "D8", "dataset": "EMNIST-Balanced"},
    {"dataset_id": "D9", "dataset": "EMNIST-Letters"},
    {"dataset_id": "D10", "dataset": "Walking"}
  ],
  "base_partition": {
    "formal_seeds": [8000, 8001, 8002, 8003, 8004, 8005, 8006, 8007, 8008, 8009],
    "materialized_pool_generation": {
      "initialization": "k-means++",
      "n_init": 20,
      "max_iter": 300,
      "tol": 0.0001,
      "algorithm": "lloyd"
    }
  },
  "BEGF": {
    "m": [30, 120, 10, 10, 10, 10, 70, 10, 10, 10],
    "mu": [1, 0.01, 1, 1, 100, 1, 10, 10, 10, 10],
    "delta": 1,
    "eta": 0.1,
    "epsilon": 1e-12
  },
  "projection_laplacian": {
    "formula": "LZ = 2 * (Z - X0 @ (X0.T @ Z))",
    "source": "partition_projection",
    "raw_feature_graph_used": false
  },
  "MM": {
    "max_iterations": 50,
    "relative_change_tolerance": 1e-6
  },
  "CG": {
    "rhs": "X0",
    "rtol": 1e-10,
    "atol": 0,
    "maxiter": null,
    "iteration_cap_semantics": "backend_default"
  },
  "final_readout": {
    "row_l2_normalization": true,
    "algorithm": "k-means",
    "seed": 9002,
    "n_init": 20,
    "max_iter": 300,
    "tol": 0.0001,
    "kmeans_algorithm": "lloyd"
  },
  "frozen_identity": {
    "statement": "Frozen X0/member identities are reused where available and are not regenerated by the public package.",
    "pool_hashes_released": false
  }
}
